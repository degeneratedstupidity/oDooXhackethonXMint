# Copy to .env and fill in real values. Never commit .env.
#
# Generate the secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"                          # DJANGO_SECRET_KEY
#   python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"  # FIELD_ENCRYPTION_KEY

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
FIELD_ENCRYPTION_KEY=change-me-32-byte-urlsafe-base64

POSTGRES_DB=dayflow

# Django connects as this restricted (non-superuser) role so RLS applies to it — a
# superuser would bypass every policy. db/init.sh creates the role from these two
# values on first start, so set them here and nowhere else.
APP_DB_USER=dayflow_app
APP_DB_PASSWORD=change-me
POSTGRES_USER=dayflow
POSTGRES_PASSWORD=change-me
